    "eslint": "^9",
    "eslint-config-next": "15.1.7",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-unused-imports": "^4.0.0",
    "husky": "^9.1.7",
